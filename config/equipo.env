# Configuracion del equipo. Editar UNA vez y subir al repo con git.
#
# Las cinco maquinas (los Jetson y las Raspberry) toman estos valores de aqui.
# No los escribas en el ~/.bashrc de cada maquina: si los escribes a mano, dos
# maquinas pueden quedar con valores distintos y no se ven entre si.

# ROS_DOMAIN_ID. El enunciado dice 42 + numero de equipo. El numero te lo da el
# docente. Todas las maquinas del equipo necesitan el MISMO numero: es el canal
# por el que hablan y, con numeros distintos, no se ven aunque esten en la misma
# red. Grupo 5 -> 42 + 5 = 47.
export ROS_DOMAIN_ID=47

# JETSON: la IP del Jetson de tu equipo. Te la da el profesor. Con ella se arma
# el ROS_DISCOVERY_SERVER.
# >>> PENDIENTE: confirmar la IP real del Jetson antes de medir. <<<
export JETSON=172.51.9.5

# Tiene que estar en 0. Con valor 1, ROS 2 funciona pero cada maquina solo habla
# consigo misma y no ve al robot.
export ROS_LOCALHOST_ONLY=0
